@page "/"

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Class="mb-4">IndexedDB LINQ Provider Demo</MudText>
    
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-3">Welcome to IndexedDB for Blazor</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2">
                        This library provides a LINQ-to-IndexedDB provider for Blazor applications, 
                        similar to Entity Framework Core but for browser storage.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Navigate to the LINQ Demo page to see it in action!
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/linq-demo">
                        View LINQ Demo
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Key Features</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            LINQ query support (Where, OrderBy, Skip, Take)
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            Async operations throughout
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            Type-safe entity management
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            Automatic schema generation from C# classes
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            Support for indexes via attributes
                        </MudListItem>
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Example Usage</MudText>
                    <MudPaper Class="pa-4" Style="background-color: #f5f5f5;">
                        <pre style="margin: 0; font-family: 'Consolas', 'Monaco', monospace;">
<code>// Initialize context
var context = new IndexedDbContext(JSRuntime, "MyDatabase");
await context.InitializeAsync(typeof(Product));

// Get a queryable set
var products = context.Set&lt;Product&gt;();

// Execute LINQ queries
var activeProducts = await products
    .Where(p => p.IsActive)
    .OrderBy(p => p.Name)
    .Skip(10)
    .Take(20)
    .ToArrayAsync();

// CRUD operations
await products.AddAsync(new Product { Name = "New Product" });
await products.UpdateAsync(existingProduct);
await products.DeleteAsync(productToDelete);</code>
                        </pre>
                    </MudPaper>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>