@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
  <MudAppBar>
    IndexedDB Manager
  </MudAppBar>
  <MudDrawer Open="true" ClipMode="DrawerClipMode.Always">
    <MudNavMenu>
      <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
      <MudNavLink Href="/linq-demo" Icon="@Icons.Material.Filled.Code">LINQ Demo</MudNavLink>
    </MudNavMenu>
  </MudDrawer>
  <MudMainContent>
    @Body
  </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
  An unhandled error has occurred.
  <a href="" class="reload">Reload</a>
  <a class="dismiss">🗙</a>
</div>